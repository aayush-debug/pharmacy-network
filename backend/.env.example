# ==============================================================================
# Pharmacy Stock Query System — Backend Environment Configuration
# Copy this file to .env to override default configuration values.
# NEVER commit .env with real credentials to version control.
# ==============================================================================

# TCP Socket Server Configuration (Main Application Communication)
TCP_HOST=127.0.0.1
TCP_PORT=5000

# UDP Configuration (Service Discovery & Low-Stock Alerts)
UDP_HOST=127.0.0.1
UDP_PORT=5001

# HTTP REST API Server Configuration
HTTP_HOST=127.0.0.1
HTTP_PORT=8000

# FTP Server Configuration (Inventory & Order Reports)
FTP_HOST=127.0.0.1
FTP_PORT=2121
FTP_USER=pharma_admin
FTP_PASS=pharma_secure_pass

# SMTP Email Configuration (Order Confirmations & Alerts - Phase 8)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_app_password
SMTP_ALERT_RECIPIENT=alerts@example.com

# Database File Path
DB_PATH=data/processed/pharmacy.db
